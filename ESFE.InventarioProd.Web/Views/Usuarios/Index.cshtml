@{
    ViewData["Title"] = "Administración de Usuarios";
}

<link rel="stylesheet" href="~/css/usuario.css" />

<div class="usuarios-container">

    <!-- ENCABEZADO -->
    <div class="page-header">
        <div>
            <h1>Administración de Usuarios y Roles</h1>
            <p>Gestiona los usuarios y los permisos asignados a cada rol.</p>
        </div>

        <div class="usuario-actual">
            <span class="usuario-icono">👤</span>
            <span>Administrador</span>
        </div>
    </div>

    <!-- CONTENIDO -->
    <div class="contenido">

        <!-- USUARIOS -->
        <section class="usuarios-section">

            <div class="section-header">
                <div>
                    <h2>Usuarios</h2>
                    <p>Lista de usuarios registrados en el sistema.</p>
                </div>

                <button class="btn-nuevo" onclick="nuevoUsuario()">
                    + Nuevo usuario
                </button>
            </div>


            <!-- USUARIO 1 -->
            <div class="usuario-card">

                <div class="usuario-info">

                    <div class="avatar">
                        AP
                    </div>

                    <div>
                        <h3>Ana Pérez</h3>
                        <p>ana.perez@empresa.com</p>
                    </div>

                </div>

                <div class="usuario-rol">
                    <span class="rol">
                        Bodeguero
                    </span>
                </div>

                <div class="usuario-estado activo">
                    Activo
                </div>

                <button class="btn-editar"
                        onclick="editarUsuario(
                    'Ana Pérez',
                    'ana.perez@empresa.com',
                    'Bodeguero',
                    'Activo'
                    )">
                    ✎
                </button>

            </div>


            <!-- USUARIO 2 -->
            <div class="usuario-card">

                <div class="usuario-info">

                    <div class="avatar">
                        LG
                    </div>

                    <div>
                        <h3>Luis Gómez</h3>
                        <p>luis.gomez@empresa.com</p>
                    </div>

                </div>

                <div class="usuario-rol">
                    <span class="rol">
                        Consulta
                    </span>
                </div>

                <div class="usuario-estado activo">
                    Activo
                </div>

                <button class="btn-editar"
                        onclick="editarUsuario(
                    'Luis Gómez',
                    'luis.gomez@empresa.com',
                    'Consulta',
                    'Activo'
                    )">
                    ✎
                </button>

            </div>


            <!-- USUARIO 3 -->
            <div class="usuario-card">

                <div class="usuario-info">

                    <div class="avatar">
                        MR
                    </div>

                    <div>
                        <h3>Marta Ríos</h3>
                        <p>marta.rios@empresa.com</p>
                    </div>

                </div>

                <div class="usuario-rol">
                    <span class="rol">
                        Administrador
                    </span>
                </div>

                <div class="usuario-estado activo">
                    Activo
                </div>

                <button class="btn-editar"
                        onclick="editarUsuario(
                    'Marta Ríos',
                    'marta.rios@empresa.com',
                    'Administrador',
                    'Activo'
                    )">
                    ✎
                </button>

            </div>


            <!-- USUARIO 4 -->
            <div class="usuario-card">

                <div class="usuario-info">

                    <div class="avatar">
                        CD
                    </div>

                    <div>
                        <h3>Carlos Díaz</h3>
                        <p>carlos.diaz@empresa.com</p>
                    </div>

                </div>

                <div class="usuario-rol">
                    <span class="rol">
                        Consulta
                    </span>
                </div>

                <div class="usuario-estado inactivo">
                    Inactivo
                </div>

                <button class="btn-editar"
                        onclick="editarUsuario(
                    'Carlos Díaz',
                    'carlos.diaz@empresa.com',
                    'Consulta',
                    'Inactivo'
                    )">
                    ✎
                </button>

            </div>

        </section>


        <!-- PERMISOS -->
        <section class="permisos-section">

            <div class="section-header">

                <div>
                    <h2>Permisos por rol</h2>
                    <p>
                        Consulta los permisos disponibles para cada rol.
                    </p>
                </div>

            </div>


            <div class="tabla-container">

                <table class="permisos-table">

                    <thead>

                        <tr>
                            <th>Permiso</th>
                            <th>Administrador</th>
                            <th>Bodeguero</th>
                            <th>Consulta</th>
                        </tr>

                    </thead>

                    <tbody>

                        <tr>
                            <td>Gestionar usuarios</td>
                            <td class="check">✓</td>
                            <td class="dash">—</td>
                            <td class="dash">—</td>
                        </tr>

                        <tr>
                            <td>Gestionar productos</td>
                            <td class="check">✓</td>
                            <td class="check">✓</td>
                            <td class="dash">—</td>
                        </tr>

                        <tr>
                            <td>Gestionar inventario</td>
                            <td class="check">✓</td>
                            <td class="check">✓</td>
                            <td class="dash">—</td>
                        </tr>

                        <tr>
                            <td>Registrar ventas</td>
                            <td class="check">✓</td>
                            <td class="check">✓</td>
                            <td class="dash">—</td>
                        </tr>

                        <tr>
                            <td>Consultar reportes</td>
                            <td class="check">✓</td>
                            <td class="check">✓</td>
                            <td class="check">✓</td>
                        </tr>

                        <tr>
                            <td>Ver auditoría</td>
                            <td class="check">✓</td>
                            <td class="dash">—</td>
                            <td class="dash">—</td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </section>

    </div>

</div>


<!-- MODAL -->
<div id="modalUsuario" class="modal">

    <div class="modal-contenido">

        <div class="modal-header">

            <h2 id="modalTitulo">
                Nuevo usuario
            </h2>

            <button class="btn-cerrar"
                    onclick="cerrarModal()">
                ×
            </button>

        </div>


        <div class="formulario">

            <label for="nombreUsuario">
                Nombre
            </label>

            <input type="text"
                   id="nombreUsuario"
                   placeholder="Ingrese el nombre">


            <label for="correoUsuario">
                Correo electrónico
            </label>

            <input type="email"
                   id="correoUsuario"
                   placeholder="Ingrese el correo">


            <label for="passwordUsuario">
                Contraseña
            </label>

            <input type="password"
                   id="passwordUsuario"
                   placeholder="Ingrese la contraseña">


            <label for="rolUsuario">
                Rol
            </label>

            <select id="rolUsuario">

                <option value="">
                    Seleccione un rol
                </option>

                <option value="Administrador">
                    Administrador
                </option>

                <option value="Bodeguero">
                    Bodeguero
                </option>

                <option value="Consulta">
                    Consulta
                </option>

            </select>


            <label for="estadoUsuario">
                Estado
            </label>

            <select id="estadoUsuario">

                <option value="Activo">
                    Activo
                </option>

                <option value="Inactivo">
                    Inactivo
                </option>

            </select>

        </div>


        <div class="modal-footer">

            <button class="btn-cancelar"
                    onclick="cerrarModal()">
                Cancelar
            </button>

            <button class="btn-guardar"
                    onclick="guardarUsuario()">
                Guardar usuario
            </button>

        </div>

    </div>

</div>


<script>

    function nuevoUsuario() {

        document.getElementById("modalTitulo").innerText =
            "Nuevo usuario";

        document.getElementById("nombreUsuario").value = "";
        document.getElementById("correoUsuario").value = "";
        document.getElementById("passwordUsuario").value = "";
        document.getElementById("rolUsuario").value = "";
        document.getElementById("estadoUsuario").value = "Activo";

        document.getElementById("modalUsuario").style.display =
            "flex";
    }


    function editarUsuario(nombre, correo, rol, estado) {

        document.getElementById("modalTitulo").innerText =
            "Editar usuario";

        document.getElementById("nombreUsuario").value =
            nombre;

        document.getElementById("correoUsuario").value =
            correo;

        document.getElementById("passwordUsuario").value =
            "";

        document.getElementById("rolUsuario").value =
            rol;

        document.getElementById("estadoUsuario").value =
            estado;

        document.getElementById("modalUsuario").style.display =
            "flex";
    }


    function cerrarModal() {

        document.getElementById("modalUsuario").style.display =
            "none";
    }


    function guardarUsuario() {

        alert("Usuario guardado correctamente.");

        cerrarModal();
    }


    window.onclick = function(event) {

        const modal =
            document.getElementById("modalUsuario");

        if (event.target === modal) {

            cerrarModal();

        }

    };

</script>