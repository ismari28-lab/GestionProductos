@{
    ViewBag.Title = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["OcultarNav"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" />
}

<main class="login-wrap">
    <section class="login-card">

        <header class="login-header">
            <h1 class="login-brand">STOCKEO</h1>
            <p class="login-subtitle">Sistema de Inventario</p>
        </header>

        <hr class="login-divider" />

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", @class = "login-form", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-field">
                <label for="usuario">Usuario o correo</label>
                <input type="text"
                       id="usuario"
                       name="usuario"
                       placeholder="ana.perez@empresa.com"
                       autocomplete="username"
                       required />
                <span class="field-error" id="usuarioError"></span>
            </div>

            <div class="form-field">
                <label for="password">Contraseña</label>
                <input type="password"
                       id="password"
                       name="password"
                       placeholder="••••••••"
                       autocomplete="current-password"
                       required />
                <span class="field-error" id="passwordError"></span>
            </div>

            <span class="form-error" id="formError" role="alert"></span>

            <button type="submit" class="btn-submit" id="btnIngresar">
                <span class="btn-text">Ingresar</span>
            </button>
        }

    </section>
</main>

<script src="~/js/login.js"></script>