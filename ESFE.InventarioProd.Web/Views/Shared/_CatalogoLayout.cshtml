<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Sneaker Shop</title>
    <link rel="stylesheet" href="~/css/styles.css" />
</head>
<body>

    <header class="site-header">
        <div class="container">
            <a href="/" class="brand">
                <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M3 17c1-3 3-5 6-6l9-3c1.5-.5 3 .5 3 2 0 1.2-.8 2.2-2 2.5l-2 .5 3 3.5c.6.7.2 1.5-.7 1.5H4.5C3.5 18 2.7 17.6 3 17Z" />
                </svg>
                <span>Sneaker Shop</span>
            </a>
            <nav class="main-nav">
                <a class="nav-link" href="/Home/Index">Products</a>
                <a class="nav-link ghost" href="/Home/About">About us</a>
                <a class="nav-link ghost" href="#" onclick="return false;">Share</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-col">
                <h4>Formas de pago</h4>
                <ul>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
                        Tarjetas de débito y crédito
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 10l9-6 9 6" /><path d="M5 10v8M19 10v8M9 10v8M15 10v8" /><path d="M3 21h18" /></svg>
                        Transferencia bancaria
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 8H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2Z" /><path d="M2 11h20" /></svg>
                        Pago contra entrega
                    </li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Contactos</h4>
                <ul>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z" opacity="0" /><path d="M3 6l9 6 9-6" /><rect x="3" y="4" width="18" height="16" rx="2" /></svg>
                        contacto@sneakershop.com
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.9 2Z" /></svg>
                        626 651 892
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12Z" /><circle cx="12" cy="10" r="2.5" /></svg>
                        Calle de María de Molina, 54 - Madrid
                    </li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Seguridad</h4>
                <span class="badge-ssl">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="14" height="14"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                    SSL
                </span>
            </div>
        </div>

        <div class="container footer-bottom">
            <span>&copy; @DateTime.Now.Year Sneaker Shop, todos los derechos reservados.</span>
            <a href="#" onclick="return false;">Más información</a>
        </div>
    </footer>

    <a class="whatsapp-float" href="https://wa.me/34626651892" target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
        <svg viewBox="0 0 32 32"><path d="M16.001 3C9.373 3 4 8.373 4 15c0 2.386.69 4.61 1.885 6.49L4 29l7.71-1.85A11.93 11.93 0 0 0 16 27c6.627 0 12-5.373 12-12S22.628 3 16.001 3Zm6.66 17.02c-.28.79-1.62 1.51-2.24 1.6-.57.09-1.29.13-2.08-.13-.48-.16-1.1-.36-1.9-.7-3.34-1.44-5.52-4.82-5.69-5.05-.17-.23-1.36-1.8-1.36-3.44s.86-2.44 1.16-2.77c.3-.34.66-.42.88-.42h.63c.2 0 .48-.08.75.57.28.66.94 2.29 1.02 2.46.08.17.13.36.03.58-.1.23-.15.36-.3.56-.15.2-.31.44-.44.6-.15.17-.3.36-.13.66.17.3.75 1.24 1.62 2.02 1.11 1 2.05 1.32 2.35 1.47.3.15.47.13.65-.08.18-.2.76-.87 1-1.17.23-.3.46-.24.77-.14.31.1 1.97.93 2.3 1.1.34.17.56.26.64.4.08.15.08.85-.2 1.64Z" /></svg>
    </a>

    <script src="~/js/script.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
