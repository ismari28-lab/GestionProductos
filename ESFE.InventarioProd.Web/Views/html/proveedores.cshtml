                    <th>ID</th>
                    <th>NOMBRE</th>
                    <th>EMPRESA</th>
                    <th>TELÉFONO</th>
                    <th>CORREO</th>
                    <th>DIRECCIÓN</th>
                    <th>ESTADO</th>
                    <th>ACCIONES</th>
