@{
    ViewData["Title"] = "Detalle del proveedor";
}

@section Styles {
    <link rel="stylesheet" href="~/css/proveedores.css" />
}

<div class="form-page">

    <div class="form-card">

        <div class="form-header">

            <div>
                <h1>Detalle del proveedor</h1>
                <p>Información registrada del proveedor</p>
            </div>

            <a href="#" class="btn-close">
                ×
            </a>

        </div>


        <div class="form-divider"></div>


        <div class="details-container">

            <div class="detail-item">
                <span>ID</span>
                <strong>P-001</strong>
            </div>

            <div class="detail-item">
                <span>Nombre</span>
                <strong>Carlos Martínez</strong>
            </div>

            <div class="detail-item">
                <span>Empresa / Compañía</span>
                <strong>Distribuidora Martínez</strong>
            </div>

            <div class="detail-item">
                <span>Teléfono</span>
                <strong>7856-2145</strong>
            </div>

            <div class="detail-item">
                <span>Correo electrónico</span>
                <strong>carlos@distribuidoramartinez.com</strong>
            </div>

            <div class="detail-item">
                <span>Dirección</span>
                <strong>San Salvador</strong>
            </div>

            <div class="detail-item">
                <span>Estado</span>

                <strong>
                    <span class="status active-status">
                        Activo
                    </span>
                </strong>

            </div>

        </div>


        <div class="form-actions">

            <a href="#" class="btn-secondary">
                Regresar
            </a>

            <a href="#" class="btn-primary">
                Editar proveedor
            </a>

        </div>

    </div>

</div>
